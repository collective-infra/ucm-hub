# Copy to .env (same folder) and fill in. .env is gitignored; this file is not,
# so never put real passwords here. Restart run.py after changing values.

# MQTT broker. sn3 only accepts connections from the mesh or whitelisted IPs.
UCM_MQTT_HOST=nyit-ucm.nycmesh.net
UCM_MQTT_PORT=1883
UCM_MQTT_USER=
UCM_MQTT_PASSWORD=

# Data source for local testing: 1 = fake nodes, or a path to a DB dump to replay.
# UCM_MOCK=1
# UCM_REPLAY=../nycmesh/meshroom-vm-oct-12-a.sql
# UCM_REPLAY_SPEED=60

# Web server. Use 0.0.0.0 to let other machines connect.
UCM_WEB_HOST=127.0.0.1
UCM_WEB_PORT=5002
